{
  "name": "kl-construction",
  "main": "./kl-construction-worker.js",
  "compatibility_date": "2026-09-21",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kl-construction-db",
      "database_id": "b5be6fab-e368-4c9e-a7ad-f861ed34d48f"
    }
  ]
}
